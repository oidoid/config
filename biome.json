{
  "$schema": "https://biomejs.dev/schemas/2.3.11/schema.json",
  "css": {"formatter": {"enabled": true, "quoteStyle": "single"}},
  "files": {"includes": ["**", "!dist"]},
  "formatter": {
    "bracketSpacing": false,
    "enabled": true,
    "indentStyle": "space"
  },
  "html": {"formatter": {"enabled": true, "indentScriptAndStyle": true}},
  "javascript": {
    "formatter": {
      "arrowParentheses": "asNeeded",
      "jsxQuoteStyle": "single",
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "none"
    }
  },
  "json": {"parser": {"allowComments": true}},
  "linter": {
    "domains": {"project": "all"},
    "rules": {
      "correctness": {"noUnusedImports": {"level": "warn", "fix": "safe"}},
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error",
        "recommended": true
      },
      "complexity": {"noThisInStatic": "off"},
      "style": {
        "noInferrableTypes": "off",
        "noNonNullAssertion": "off",
        "noParameterAssign": "off",
        "useNumberNamespace": "off",
        "noRestrictedImports": {
          "level": "warn",
          "options": {
            "paths": {
              "@oidoid/void": {
                "allowImportNames": ["*"],
                "message": "use a namespace import: `import * as V from '@oidoid/void'`."
              }
            }
          }
        }
      },
      "suspicious": {
        "noAssignInExpressions": "off",
        "noImplicitAnyLet": "off",
        "noRedeclare": "off",
        "useGetterReturn": "off"
      }
    }
  },
  "vcs": {"enabled": true, "clientKind": "git", "useIgnoreFile": true}
}
